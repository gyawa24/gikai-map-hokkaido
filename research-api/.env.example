# Local source data. Paths are resolved from research-api/ when npm scripts run there.
GIKAI_SEARCH_INDEX_PATH=../site/public/generated/search-index.json
GIKAI_DATA_PATH=../site/data

# AWS uses the public generated index and GitHub Raw instead of local files.
GIKAI_SEARCH_INDEX_URL=https://chihougikai.com/generated/search-index.json
GIKAI_CITY_INDEX_BASE_URL=https://chihougikai.com/generated/search-indexes
GIKAI_DATA_RAW_BASE_URL=https://raw.githubusercontent.com/gyawa24/gikai-map-hokkaido/main/site/data
GIKAI_PUBLIC_BASE_URL=https://chihougikai.com
GIKAI_FETCH_TIMEOUT_MS=5000

AWS_REGION=ap-northeast-1
AI_ENABLED=true
BEDROCK_MODEL_ID=
BEDROCK_MAX_OUTPUT_TOKENS=3000
BEDROCK_TIMEOUT_MS=9000

# Optional price inputs used only to estimate cost in response metadata.
BEDROCK_INPUT_COST_PER_MILLION_TOKENS=
BEDROCK_OUTPUT_COST_PER_MILLION_TOKENS=

MAX_RESULTS_PER_SEARCH=20
MAX_EVIDENCE_ITEMS=8
MAX_EVIDENCE_CHARS=30000
MAX_LLM_CALLS_PER_REQUEST=2
MAX_DAILY_REQUESTS=50
MAX_MONTHLY_REQUESTS=500
RESEARCH_CACHE_TTL_SECONDS=600
INDEX_CACHE_TTL_SECONDS=900

# Set by the SAM stack in AWS. If omitted locally, an in-memory quota is used.
USAGE_TABLE_NAME=
DEBUG_RESEARCH=false
PORT=8788
LOCAL_API_KEY=
