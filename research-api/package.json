{
  "name": "@chihougikai/policy-research-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file=.env watch src/local/server.ts",
    "start": "node --env-file=.env dist/src/local/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "smoke": "node scripts/smoke-research-cases.mjs",
    "aws:preflight": "node scripts/aws-predeploy-check.mjs",
    "sam:validate": "SAM_CLI_TELEMETRY=0 sam validate --lint -t infra/template.yaml",
    "sam:build": "SAM_CLI_TELEMETRY=0 sam build -t infra/template.yaml",
    "sam:smoke": "node scripts/smoke-lambda-bundle.mjs",
    "sam:deploy": "sam deploy --guided"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.0.0",
    "@aws-sdk/client-dynamodb": "^3.0.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
