    "schedule_name": "02月12日",
    "date": "2021-02-12",
    "speaker": "11番鶴間松彦議員、１番",
    "speaker_role": "質問",
    "is_procedural": false,
    "member_name": "鶴間 松彦",
    "member_faction": "",
    "text": "杉本岳大議員。\n0 【東川町議会第１回臨時会】\n○開 会",
    "text_length": 28,
    "source": {
      "minutes_file": "data/higashikawa/minutes/20212001.json",
