    "is_procedural": false,
    "member_name": "杉本 岳大",
    "member_faction": "",
    "text": "山家祥幸議員を指名いたします。\n○日程第２ 会期の決定",
    "text_length": 27,
    "source": {
      "minutes_file": "data/higashikawa/minutes/20232001.json",
