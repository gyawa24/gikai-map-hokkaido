    "speaker": "町長（松岡",
    "speaker_role": "答弁",
    "is_procedural": false,
    "member_name": null,
    "member_faction": null,
    "text": "ありません。\n市郎君）\n1 【東川町議会第１回臨時会】",
    "text_length": 27,
    "source": {
      "minutes_file": "data/higashikawa/minutes/20232001.json",
