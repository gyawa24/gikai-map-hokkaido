  },
  {
    "id": "higashikawa-20212004-1-008",
    "municipality": "higashikawa",
    "council_id": 20212004,
    "council_name": "令和3年第4回臨時会",
    "schedule_id": 1,
    "schedule_name": "05月10日",
    "date": "2021-05-10",
    "speaker": "安原芳博議員、９番",
    "speaker_role": "質問",
    "is_procedural": false,
    "member_name": null,
    "member_faction": null,
    "text": "正満正義議員を指名します。\n○日程第２ 会期の決定",
    "text_length": 25,
    "source": {
      "minutes_file": "data/higashikawa/minutes/20212004.json",
      "schedule_id": 1,
      "minute_ids": [
        "1-table-013"
      ]
