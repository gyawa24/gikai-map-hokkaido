    "is_procedural": false,
    "member_name": null,
    "member_faction": null,
    "text": "正満正義議員。\n0 【東川町議会第４回臨時会】\n○開 会",
    "text_length": 28,
    "source": {
      "minutes_file": "data/higashikawa/minutes/20212004.json",
