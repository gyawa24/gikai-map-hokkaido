  {
    "id": "higashikawa-20222006-1-007",
    "municipality": "higashikawa",
    "council_id": 20222006,
    "council_name": "令和4年第6回臨時会",
    "schedule_id": 1,
    "schedule_name": "10月24日",
    "date": "2022-10-24",
    "speaker": "６番畑中雅晴議員、７番",
    "speaker_role": "質問",
    "is_procedural": false,
    "member_name": null,
    "member_faction": null,
    "text": "藤倉智恵子議員。\n0 【東川町議会第６回臨時会】\n○開 会",
    "text_length": 29,
    "source": {
      "minutes_file": "data/higashikawa/minutes/20222006.json",
