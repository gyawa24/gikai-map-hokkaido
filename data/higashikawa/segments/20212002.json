    "is_procedural": false,
    "member_name": "薦田 敏次",
    "member_faction": "",
    "text": "能登暢吉議員。\n0 【東川町議会第２回臨時会】\n○開 会",
    "text_length": 28,
    "source": {
      "minutes_file": "data/higashikawa/minutes/20212002.json",
