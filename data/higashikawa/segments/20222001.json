    "schedule_name": "03月29日",
    "date": "2022-03-29",
    "speaker": "能登暢吉議員、６番",
    "speaker_role": "質問",
    "is_procedural": false,
    "member_name": null,
    "member_faction": "",
    "text": "畑中雅晴議員を指名します。\n○日程第２ 会期の決定",
    "text_length": 25,
    "source": {
      "minutes_file": "data/higashikawa/minutes/20222001.json",
