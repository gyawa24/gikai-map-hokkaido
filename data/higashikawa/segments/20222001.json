  {
    "id": "higashikawa-20222001-1-008",
    "municipality": "higashikawa",
    "council_id": 20222001,
    "council_name": "令和4年第1回臨時会",
    "schedule_id": 1,
    "schedule_name": "03月29日",
    "date": "2022-03-29",
    "speaker": "町長（松岡",
    "speaker_role": "答弁",
    "is_procedural": false,
    "member_name": null,
    "member_faction": null,
    "text": "（登壇）\n市郎君） おはようございます。\n今日は令和４年度の東川町議会の第１回の臨時会招集させていただき\nましたけれども、全員の議員の皆様方のご出席をいただきまして、誠に\nありがとうございます。\n本日、提案申し上げます案件につきましては、令和３年度の最終補正\nになると思いますけれども、令和３年度の一般会計の補正予算というこ\nとの提案でございますので、全会一致で議決を賜りますように、お願い\nを申し上げます。ありがとうございます。\n○議事日程の報告",
    "text_length": 224,
    "source": {
      "minutes_file": "data/higashikawa/minutes/20222001.json",
      "schedule_id": 1,
      "minute_ids": [
        "1-table-011"
      ]
