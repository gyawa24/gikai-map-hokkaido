  {
    "id": "toyoura-20241111-1-026",
    "municipality": "toyoura",
    "council_id": 20241111,
    "council_name": "令和6年定例会11月会議",
    "schedule_id": 1,
    "schedule_name": "定例会11月会議 （11月15日）",
    "date": "2024-11-15",
    "speaker": "高橋美香国民健康保険病院事務局長",
    "speaker_role": "答弁",
    "is_procedural": true,
    "member_name": null,
    "member_faction": null,
    "text": "豊浦町国民健康保険病院事務局長の高橋です。\nよろしくお願いいたします。\n- 5 -",
    "text_length": 41,
    "source": {
      "minutes_file": "data/toyoura/minutes/20241111.json",
