  {
    "id": "mikasa-20262001-1-004",
    "municipality": "mikasa",
    "council_id": 20262001,
    "council_name": "令和8年第1回臨時会",
    "schedule_id": 1,
    "schedule_name": "会議録 令和8年 第1回臨時会&nbsp; 1月16日",
    "date": "2026-01-16",
    "speaker": "西城賢策市長",
    "speaker_role": "答弁",
    "is_procedural": false,
    "member_name": null,
    "member_faction": null,
    "text": "議案第１号三笠市水道給水条例の一部を改正する条例の制定につ\nいて提案説明申し上げます。\n今回の改正は、物価高騰対応重点支援地方創生臨時交付金を活用した水道料金減額事業\nの実施に伴い、必要な改正を行うものであります。\n改正の内容は、令和８年４月分から９月分までの水道料金の減免について、規定を追加\nするものであります。\n施行期日は、令和８年２月１日であります。\n以上、提案説明といたしますので、御審議くださいますようよろしくお願い申し上げま\nす。",
    "text_length": 222,
    "source": {
      "minutes_file": "data/mikasa/minutes/20262001.json",
      "schedule_id": 1,
      "minute_ids": [
        "1-inline-013"
      ]
    }
  },
  {
    "id": "mikasa-20262001-1-005",
