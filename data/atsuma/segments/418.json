  {
    "id": "atsuma-418-1-004",
    "municipality": "atsuma",
    "council_id": 418,
    "council_name": "令和 ７年  ５月 臨時会",
    "schedule_id": 1,
    "schedule_name": "05月02日－01号",
    "date": "2025-05-02",
    "speaker": "（高田芳和君）",
    "speaker_role": "質問",
    "is_procedural": false,
    "member_name": null,
    "member_faction": null,
    "text": "連帯負担割合なのですけれども、町７割、被告会社３割で合意に至っていますけれども、合意に至った経緯をもう少し詳しく説明をお願いします。",
    "text_length": 66,
    "source": {
      "minutes_file": "data/atsuma/minutes/418.json",
