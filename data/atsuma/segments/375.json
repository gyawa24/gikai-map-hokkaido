      "minute_ids": [
        32
      ]
    }
  },
  {
    "id": "atsuma-375-1-009",
    "municipality": "atsuma",
    "council_id": 375,
    "council_name": "令和 ６年  １月 臨時会",
    "schedule_id": 1,
    "schedule_name": "01月22日－01号",
    "date": "2024-01-22",
    "speaker": "（高田議員）",
    "speaker_role": "質問",
    "is_procedural": false,
    "member_name": "高田芳和",
    "member_faction": "",
    "text": "関連質問なんですけれども、こども園の給食、３歳以上については給食センター外部委託っていうことで、これについては３歳未満の民間委託っていうことですけども、今まで自園調理で従事してた人がいなくなるということですか。",
    "text_length": 105,
    "source": {
