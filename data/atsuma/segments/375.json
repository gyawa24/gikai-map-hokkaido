    "municipality": "atsuma",
    "council_id": 375,
    "council_name": "令和 ６年  １月 臨時会",
    "schedule_id": 1,
    "schedule_name": "01月22日－01号",
    "date": "2024-01-22",
    "speaker": "住民課健康推進子育て支援担当参事（宮本幸世君）",
    "speaker_role": "答弁",
    "is_procedural": false,
    "member_name": null,
    "member_faction": null,
    "text": "こども園つみきの自園調理に従事している方につきましては、１名正職員とほかパート２名会計年度任用職員さんで事業運営をしていただいておりますが、１名の正職員の方が本年度をもって退職ということで今回人員を適正に確保するということも含めまして、民間委託とさせていただくことと検討しております。",
    "text_length": 142,
    "source": {
      "minutes_file": "data/atsuma/minutes/375.json",
      "schedule_id": 1,
      "minute_ids": [
        36
      ]
