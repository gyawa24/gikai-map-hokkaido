<script type="text/javascript">
	$(function($){
		$('#translate_selector').change(function(){
			var url = '';
			switch ($(this).val()){
				case '1':
					url = 'https://www.town.kutchan.hokkaido.jp.e.acx.hp.transer.com';
					break;
				case '2':
					url = 'https://www.town.kutchan.hokkaido.jp.k.acx.hp.transer.com';
					break;
				case '3':
					url = 'https://www.town.kutchan.hokkaido.jp.c.acx.hp.transer.com';
					break;
				case '4':
					url = 'https://www.town.kutchan.hokkaido.jp.t.acx.hp.transer.com';
					break;
			}
			if(url.length > 0){
/*				window.location.href = url;*/
				window.open(url+location.pathname);
			}
		});
	});
</script>
