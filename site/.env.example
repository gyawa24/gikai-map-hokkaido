# Optional Notion article CMS
# Production default should stay local. Use hybrid/notion only for preview checks.
ARTICLE_SOURCE=local
# Use a Notion internal integration token with read content permission.
NOTION_TOKEN=
# Prefer the data source ID copied from "Manage data sources" in Notion.
NOTION_ARTICLES_DATA_SOURCE_ID=
# Optional fallback: if only the database ID is known, the app reads its first data source.
NOTION_ARTICLES_DATABASE_ID=
NOTION_VERSION=2026-03-11

# Policy research BFF (server-side only; never prefix these with NEXT_PUBLIC_)
# Set the full, fixed upstream endpoint including /research.
POLICY_RESEARCH_API_URL=
POLICY_RESEARCH_API_KEY=
POLICY_RESEARCH_TIMEOUT_MS=55000
# Shared access password for the unpublished /research and /data-loop-preview pages (12 characters or longer).
POLICY_RESEARCH_ACCESS_PASSWORD=
# Use a separately generated random value (32 characters or longer) to sign 12-hour sessions.
POLICY_RESEARCH_SESSION_SECRET=

# Notes
# - Do not store production keys in local files.
# - MCP is handled by mcp-server/ or a future separate worker, not the public site runtime.
